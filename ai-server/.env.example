# ─── Server ────────────────────────────────────────────────
PORT=3000
APP_URL=http://localhost:3000

# ─── Admin login (single tenant) ───────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 32+ random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ─── Supabase ──────────────────────────────────────────────
# Project Settings → API Keys. Use the new secret key (sb_secret_...),
# not the legacy anon / service_role JWTs. It never leaves the server.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# ─── LLM providers (set any you use) ───────────────────────
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# provider:model, used until you pick one in Settings → LLM
DEFAULT_MODEL=deepseek:deepseek-v4-flash

# Speech to text (Groq). Without this the mic button and the transcribe links are off.
GROQ_API_KEY=
TRANSCRIBE_MODEL=whisper-large-v3-turbo

# Web search (Tavily). Without it the agent has no web_search tool, and will make up
# urls — YouTube links especially — rather than admit it doesn't know one.
TAVILY_API_KEY=
